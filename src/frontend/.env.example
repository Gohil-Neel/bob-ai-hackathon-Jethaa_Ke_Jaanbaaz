# =============================================================================
# SupplyShield AI — Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is in .gitignore.
#
# All Vite frontend environment variables must start with VITE_
# =============================================================================

# Supabase REST Configuration (Required for live database connection)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini API (100% Free key from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your-google-gemini-api-key-here

# Optional Backend API base URL (Leave empty when querying Supabase directly)
VITE_API_BASE_URL=

# Application mode
VITE_APP_ENV=development
