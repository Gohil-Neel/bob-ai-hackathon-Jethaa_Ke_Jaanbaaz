# =============================================================================
# SupplyShield AI — Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is in .gitignore.
#
# All Vite frontend environment variables must start with VITE_
# =============================================================================

# Backend API base URL
# In development, this is proxied via vite.config.ts so you can leave it empty
# In production, set to your deployed ASP.NET Core backend URL
VITE_API_BASE_URL=http://localhost:5000

# Application mode — affects mock data usage
# "development" uses mock data when API is unavailable
# "production" always uses real API
VITE_APP_ENV=development
