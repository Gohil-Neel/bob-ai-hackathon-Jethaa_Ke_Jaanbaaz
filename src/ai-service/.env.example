# =============================================================================
# SupplyShield AI — Python AI Service Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# =============================================================================

# ── Service ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8001

# ── IBM watsonx.ai (Phase 13) ─────────────────────────────────────────────────
# Get these from IBM Cloud → watsonx.ai → Project Settings
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional endpoint — choose closest data centre:
#   us-south : https://us-south.ml.cloud.ibm.com
#   eu-de    : https://eu-de.ml.cloud.ibm.com
#   eu-gb    : https://eu-gb.ml.cloud.ibm.com
#   jp-tok   : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID — recommended for logistics grounded analysis:
#   ibm/granite-13b-instruct-v2      (balanced quality / speed)
#   ibm/granite-20b-multilingual     (multilingual routes)
#   ibm/granite-3-8b-instruct        (faster, smaller)
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
