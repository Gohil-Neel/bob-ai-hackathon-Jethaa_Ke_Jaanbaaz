<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SupplyShield.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SupplyShield.Application\SupplyShield.Application.csproj" />
    <ProjectReference Include="..\SupplyShield.Infrastructure\SupplyShield.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Use built-in .NET 10 OpenAPI support via Microsoft.AspNetCore.OpenApi.
      Swashbuckle is NOT used — its transitive dependency on Microsoft.OpenApi 2.x
      has a known vulnerability (GHSA-v5pm-xwqc-g5wc).
      Using 10.0.12 which depends on Microsoft.OpenApi 3.x (patched).
      Scalar is used as the API browser UI (no vulnerability).
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.5.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
